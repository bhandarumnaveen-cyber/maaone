NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Razorpay (Dashboard → Settings → API Keys / Webhooks). Leave blank until ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email through Hostinger SMTP (hPanel → Emails). Leave SMTP_USER/SMTP_PASS blank to skip sending.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@one.maalabs.in
SMTP_PASS=
EMAIL_FROM="Maa One <noreply@one.maalabs.in>"
# Replies from customers go here; admin alerts (contact, support, refunds, payments) go to ADMIN_ALERT_EMAIL.
EMAIL_REPLY_TO=hello@maalabs.in
ADMIN_ALERT_EMAIL=hello@maalabs.in

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Seller details printed on GST invoice PDFs only (never shown on the website)
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
INVOICE_SAC=997331

# Analytics (optional). Visitors see a cookie notice and tracking starts only after they accept.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile spam protection (optional). Forms show the widget only when both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
