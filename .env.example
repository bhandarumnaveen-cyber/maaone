NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Razorpay (Dashboard → Settings → API Keys / Webhooks). Leave blank until ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend). Leave blank to skip sending.
RESEND_API_KEY=
EMAIL_FROM="Maa One <hello@maalabs.in>"

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Seller details printed on GST invoice PDFs only (never shown on the website)
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
INVOICE_SAC=997331

# Analytics (optional). Visitors see a cookie notice and tracking starts only after they accept.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile spam protection (optional). Forms show the widget only when both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
